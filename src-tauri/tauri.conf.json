{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeoTypst",
  "version": "0.7.2",
  "identifier": "de.neotypst.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NeoTypst",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        },
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "resources": {
      "dictionaries/*": "dictionaries/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0M0M4NkMzREY4N0Y3ODMKUldTRDk0ZmZ3NFk4cEQyVlFyaXlpZUMvRjUrSWxNM2VCd3hiVDRaNzZjOHArNEpBOVN5bzEvQ28K",
      "endpoints": [
        "https://github.com/LinusCode146/neotypst/releases/latest/download/latest.json"
      ]
    }
  }
}
